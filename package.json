{
  "name": "@cococopi/humanlock",
  "version": "0.1.0",
  "description": "Client-side automated-agent and AI computer-use detection for high-trust flows. Framework-agnostic core with React, Vue, Svelte and vanilla adapters, plus signed verdicts for server-side scoring.",
  "keywords": [
    "bot-detection",
    "ai-agent-detection",
    "computer-use",
    "captcha",
    "anti-automation",
    "exam-integrity",
    "proctoring",
    "honeypot",
    "behavioral-biometrics",
    "liveness"
  ],
  "license": "MIT",
  "author": "CocoCopi",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=17",
    "svelte": ">=4",
    "vue": ">=3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "svelte": "^4.2.19",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/CocoCopi"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CocoCopi/humanlock.git"
  },
  "bugs": {
    "url": "https://github.com/CocoCopi/humanlock/issues"
  },
  "homepage": "https://github.com/CocoCopi/humanlock#readme"
}
